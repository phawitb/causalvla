+def observation_to_video_frames(observation: dict[str, Any]) -> np.ndarray:
+    """Convert the primary post-environment-processor image into uint8 BHWC frames."""
+    image_keys = sorted(
+        key
+        for key, value in observation.items()
+        if key.startswith("observation.images.") and isinstance(value, torch.Tensor) and value.ndim == 4
+    )
+    if not image_keys:
+        raise ValueError("Processed observation has no batched image tensor to record.")
+    images = observation[image_keys[0]].detach().to(device="cpu", dtype=torch.float32)
+    return images.clamp(0, 1).mul(255).round().to(torch.uint8).permute(0, 2, 3, 1).numpy()
+
